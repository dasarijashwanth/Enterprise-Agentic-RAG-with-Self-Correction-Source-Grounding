# Copy to .env and fill in real values. Never commit a filled-in .env.
OPENAI_API_KEY=
COHERE_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Local LEANN dense index (HNSW backend). No cloud vector DB.
LEANN_INDEX_PATH=data/leann_index
LEANN_BACKEND=hnsw
LEANN_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_WORDS=200
CHUNK_OVERLAP_WORDS=40
